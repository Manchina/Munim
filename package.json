{
  "name": "munim",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace @munim/api\" \"npm run dev --workspace @munim/web\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build --workspace @munim/web && npm run build --workspace @munim/api",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env packages/db/scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env packages/db/scripts/seed.ts",
    "db:invite": "tsx --env-file=.env packages/db/scripts/invite.ts",
    "test:e2e": "npm run build --workspace @munim/web && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@munim/command-parser": "0.1.0",
    "@munim/contracts": "0.1.0",
    "@munim/db": "0.1.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
